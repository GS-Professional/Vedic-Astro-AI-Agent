# --- Computation layer -------------------------------------------------------
# Sidereal zero-point. LAHIRI (Chitrapaksha) is the Indian standard and the default.
# Any value from jhora.const.available_ayanamsa_modes is accepted.
VEDIC_AYANAMSA=LAHIRI

# Directory holding the Swiss Ephemeris *.se1 files (defaults to <package>/data/ephe).
# VEDIC_EPHE_DIR=./ephe

# --- Tool backend ------------------------------------------------------------
# "local" = run PyJHora in-process (default, fastest, no server needed).
# "mcp"   = route every tool call through a pyjhora-mcp server
#           (https://github.com/chinmay-sh/pyjhora-mcp).
VEDIC_TOOL_BACKEND=local

# For the mcp backend, set ONE of:
#   stdio:  command line that starts the server, e.g.
# VEDIC_MCP_COMMAND=uv run --project /path/to/pyjhora-mcp fastmcp run /path/to/pyjhora-mcp/src/pyjhora_mcp/server.py
#   HTTP:   base URL of a running server (docker compose up in that repo)
# VEDIC_MCP_URL=http://localhost:8000/mcp
# VEDIC_MCP_API_KEY=

# --- LLM integration (optional) ----------------------------------------------
# Without these the agent runs fully deterministic: planning and interpretation are
# rule-based and every sentence is assembled from computed evidence. With an
# OpenAI-compatible endpoint the planner and interpreter get LLM assistance, but
# every factual claim is still checked against the computation evidence.
# OPENAI_API_KEY=
# VEDIC_LLM_BASE_URL=https://api.openai.com/v1
# VEDIC_LLM_MODEL=gpt-4o-mini

# --- Agent behaviour ----------------------------------------------------------
VEDIC_MAX_TOOL_ROUNDS=3
